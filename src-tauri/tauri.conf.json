{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoicePack",
  "version": "0.1.0",
  "identifier": "com.schallophy.voicepack",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "VoicePack",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "theme": null
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
